# On-premise player — optional settings.
#
# You do not need this file. Every value below is already the default in the
# code, so a fresh clone builds and runs correctly with no configuration.
# Copy it to .env.local only if you need to change one of them.
#
#   cp .env.example .env.local
#
# .env and .env.local are gitignored, deliberately — nothing with a secret in
# it should ever be committed. That is why the defaults live in the source
# instead of in an env file that would not survive a clone.


# Draw the overlay. Set to 0 to fall back to the legacy engine, which for this
# build means a bare video with no personalisation on it.
NEXT_PUBLIC_OVERLAY_V2=1

# Where the campaign and recipient files are served from, relative to the
# host's own web root. Matches the folder shipped at public/onprem.
NEXT_PUBLIC_ONPREM_BASE=/onprem

# Origins the network guard will allow, comma-separated. Same-origin is always
# allowed and needs no entry here; add your own API if it lives elsewhere.
#
#   NEXT_PUBLIC_ONPREM_ALLOWED_ORIGINS=https://api.your-domain
#
# Note a <video src> or <img src> is a browser-initiated load and never passes
# through fetch or XHR, so the guard cannot see it. Listing a media origin here
# documents intent; a Content-Security-Policy header on your server is what
# actually enforces it. See README-ONPREM.md.
NEXT_PUBLIC_ONPREM_ALLOWED_ORIGINS=

# Deliberately absent: NEXT_PUBLIC_API.
#
# Every call the stock player makes to Personaliz is built from it. With no
# value there is nothing to call — the absence is the guarantee, not a setting
# that can be flipped back on by accident. Do not add it.
