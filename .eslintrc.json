{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": ["error"],
    "no-unused-expressions": ["warn"]
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
